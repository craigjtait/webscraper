AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_APP_KEY=
AI_MODEL_NAME=gpt-5-nano
AI_API_VERSION=2025-04-01-preview

# Cisco AI gateway base URL (recommended)
AI_ENDPOINT=https://chat-ai.cisco.com

# If your endpoint already includes /openai/deployments, that works too:
# AI_ENDPOINT=https://chat-ai.cisco.com/openai/deployments

# Optional overrides
# AI_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
# AI_APP_KEY_HEADER=api-key
