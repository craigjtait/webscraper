AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_APP_KEY=
AI_MODEL_NAME=gpt-5-nano
AI_API_VERSION=2025-04-01-preview
AI_CHAT_BASE_URL=https://chat-ai.cisco.com/openai/deployments
AI_TIMEOUT_SECONDS=120

# Optional OAuth scope from Cisco API Console (CIRCUIT_OAUTH_SCOPE alias supported)
# AI_SCOPE=

# Optional overrides
# AI_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token

# pamBot / Circuit aliases also work:
# CIRCUIT_CLIENT_ID, CIRCUIT_CLIENT_SECRET, CIRCUIT_APP_KEY,
# CIRCUIT_MODEL_NAME, CIRCUIT_API_VERSION, CIRCUIT_CHAT_BASE_URL,
# CIRCUIT_TOKEN_URL, CIRCUIT_OAUTH_SCOPE
