AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_APP_KEY=
AI_MODEL_NAME=gpt-5-nano
AI_API_VERSION=2025-04-01-preview
AI_ENDPOINT=https://chat-ai.cisco.com

# Scope registered in Cisco API Console for chat-ai access (often required)
# AI_SCOPE=

# Auth modes:
# - oauth (default): Bearer token from OAuth + api-key header
# - bearer_app_key: Authorization: Bearer {AI_APP_KEY} only
# - api_key_only: api-key header only, no OAuth
# AI_AUTH_MODE=oauth

# Token request style for oauth mode (Cisco API Console recommends basic)
# AI_TOKEN_AUTH=basic

# Optional overrides
# AI_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
# AI_APP_KEY_HEADER=api-key
